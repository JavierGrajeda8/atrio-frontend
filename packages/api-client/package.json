{
  "name": "@atrio/api-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mocks": "./src/mocks.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../openapi/openapi.json -o src/generated/schema.d.ts && node scripts/generate-mocks.mjs",
    "postinstall": "pnpm run generate",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@atrio/config": "workspace:*",
    "msw": "^3.0.7",
    "openapi-typescript": "^7.13.0"
  },
  "dependencies": {
    "@atrio/i18n": "workspace:^",
    "openapi-fetch": "^0.17.0"
  }
}

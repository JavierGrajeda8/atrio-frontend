{
  "name": "atrio-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@atrio/config": "workspace:*",
    "@tailwindcss/node": "^4",
    "@types/node": "^22",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=10 <11": "^11.0.1"
    }
  }
}
